# --- Ephemeral / JIT scratch scripts ---
_*.py
_*.js
_*.sh
__pycache__/
*.pyc

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Build artifacts ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
build/

# --- Credentials ---
*.token
*_token
*_secret
.env
.env.*
keys.json

# --- Local-only working files ---
*.tmp
*.bak
~$*
